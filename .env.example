# Google Gemini API Key (Recommended Free Tier - No credit card needed!)
# Obtain free from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Alternative Free Tier - Fast Llama models)
# Obtain free from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Paid Tier)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
